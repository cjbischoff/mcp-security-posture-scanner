{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[],"tool":{"driver":{"name":"Semgrep OSS","rules":[{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Potential data leak: MCP scan metadata (descriptions, schemas, snapshots) may be sent to an external service. The core rule engine must never feed target-server data to an LLM. See docs/permissions.md.\n"},"help":{"markdown":"Potential data leak: MCP scan metadata (descriptions, schemas, snapshots) may be sent to an external service. The core rule engine must never feed target-server data to an LLM. See docs/permissions.md.\n\n\n<b>References:</b>\n - [https://github.com/DataTalksClub/ai-dev-tools-zoomcamp](https://github.com/DataTalksClub/ai-dev-tools-zoomcamp)\n","text":"Potential data leak: MCP scan metadata (descriptions, schemas, snapshots) may be sent to an external service. The core rule engine must never feed target-server data to an LLM. See docs/permissions.md.\n"},"id":"security.semgrep.rules.no-llm-on-untrusted-mcp-data","name":"security.semgrep.rules.no-llm-on-untrusted-mcp-data","properties":{"precision":"very-high","tags":["CWE-912: Backdoor","security"]},"shortDescription":{"text":"Semgrep Finding: security.semgrep.rules.no-llm-on-untrusted-mcp-data"}}],"semanticVersion":"1.179.0"}}}],"$schema":"https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/schemas/sarif-schema-2.1.0.json"}
