  "cards": [
    { "dot": "emerald", "title": "Primary path", "items": [
      "POST /api/scans checks consent, stores a pending scan, returns 201",
      "Background task: connect, list tools/resources/prompts, run rules, store findings",
      "SPA polls the report every 1.5 s; the API returns 409 until the scan finishes"
    ] },
    { "dot": "rose", "title": "Guardrails", "items": [
      "Public mode runs only bundled fixtures; ALLOW_ARBITRARY_STDIO lifts this locally",
      "External HTTP URLs need allow_external=true",
      "Client never sends tools/call; no LLM reads target text"
    ] },
    { "dot": "amber", "title": "Known gaps", "items": [
      "HTTP transport raises \"not yet implemented\", so HTTP scans end FAILED",
      "MCP-005 exists but is not registered",
      "allow_external is stored, but no log line records it"
    ] },
    { "dot": "slate", "title": "Runtime", "items": [
      "Compose: db, backend, nginx frontend, oncall, lgtm",
      "Render: one image, FastAPI serves the SPA from STATIC_DIR",
      "On-call agent uses the backend admin API with ADMIN_TOKEN"
    ] }
  ]
