# Copy to .env (git-ignored) to override compose defaults.
# Bearer token for /api/admin/* fault injection. Compose falls back to
# "local-admin-token" when unset; pick your own for anything beyond localhost.
# Unset in a deployed env = admin routes return 404.
ADMIN_TOKEN=local-admin-token

# --- On-call agent (oncall service). All optional. ---
# OpenAI-compatible Chat Completions provider. Leave empty to run the
# deterministic runbook only (the demo incident is still fixed).
# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1,
# http://host.docker.internal:11434/v1 (Ollama).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Seconds to wait before re-checking after a fix.
VERIFY_WAIT_SECONDS=15
# Render deploy hook URL: enables the redeploy action (same image = restart).
RENDER_DEPLOY_HOOK=
# GitHub: enables rollback (deploy.yml dispatch with ROLLBACK_TAG) and
# incident issues. Token needs actions:write and issues:write on the repo.
ONCALL_GITHUB_TOKEN=
ONCALL_GITHUB_REPOSITORY=
ROLLBACK_TAG=
